DATABASE_URL=postgresql://localhost/liffy
REDIS_URL=redis://localhost:6379/0
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Must byte-match the Authorization callback URL on the GitHub OAuth App.
GITHUB_REDIRECT_URI=http://localhost:8000/auth/github/callback
GITHUB_WEBHOOK_SECRET=
GITHUB_TOKEN=
# At least 32 bytes; the app refuses to mint tokens with a shorter key, and
# refuses the built-in dev default entirely when DEBUG=False.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30
OPENAI_API_KEY=
DEBUG=True

# Comma-separated origins allowed to call the API (the Vite dev server).
CORS_ORIGINS=http://localhost:5173
