DATABASE_URL=postgresql://localhost/liffy
REDIS_URL=redis://localhost:6379/0
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Must byte-match the Authorization callback URL on the GitHub OAuth App:
# same scheme, host, port and path, no trailing slash.
GITHUB_REDIRECT_URI=http://localhost:8000/auth/github/callback
GITHUB_WEBHOOK_SECRET=
GITHUB_TOKEN=
# HS256 (not the report's RS256 — reasoning is in auth_service.py's docstring).
# Must be at least 32 bytes; the app refuses to mint tokens with a shorter key,
# and refuses the built-in dev default entirely when DEBUG=False.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30
# LLM provider — any OpenAI-compatible API.
# Real OpenAI: set OPENAI_API_KEY, leave OPENAI_BASE_URL empty (models default to gpt-4o / text-embedding-3-small).
# Gemini (free tier): OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
#                     LLM_MODEL=gemini-2.5-flash  EMBEDDING_MODEL=gemini-embedding-001
OPENAI_API_KEY=
OPENAI_BASE_URL=
LLM_MODEL=gpt-4o
EMBEDDING_MODEL=text-embedding-3-small
DEBUG=True

# Comma-separated origins allowed to call the API (the Vite dev server).
CORS_ORIGINS=http://localhost:5173
