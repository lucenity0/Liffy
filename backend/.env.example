DATABASE_URL=postgresql://localhost/liffy
REDIS_URL=redis://localhost:6379/0
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Must byte-match the Authorization callback URL on the GitHub OAuth App:
# same scheme, host, port and path, no trailing slash.
GITHUB_REDIRECT_URI=http://localhost:8000/auth/github/callback
# Where the OAuth callback hands the browser back to. Must be where the SPA is
# served: the callback redirects here with the token pair in the URL fragment.
FRONTEND_URL=http://localhost:5173
GITHUB_WEBHOOK_SECRET=
GITHUB_TOKEN=
# HS256 (not the report's RS256 — reasoning is in auth_service.py's docstring).
# Must be at least 32 bytes; the app refuses to mint tokens with a shorter key,
# and refuses the built-in dev default entirely when DEBUG=False.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30
# ── Review LLM ────────────────────────────────────────────────────────────────
# LLM_PROVIDER=anthropic    -> official Anthropic SDK, needs ANTHROPIC_API_KEY
# LLM_PROVIDER=openai       -> OpenAI wire format, so it also covers anything
#                              that emulates it (see the two no-cost options)
# LLM_PROVIDER=claude_code  -> drives the locally-installed Claude Code CLI,
#                              which signs in with your own Pro/Max
#                              subscription. The only provider needing no API
#                              key. Local (non-Docker) runs only: the
#                              credentials live in your home directory, not in
#                              the container. Do not use this with an API key
#                              set — the `anthropic` provider is cheaper and
#                              faster for identical output.
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
# Thinking is on by default on this model family, so effort is the real cost
# lever. Medium is the deliberate review default.
ANTHROPIC_EFFORT=medium
# Caps thinking AND response text together on Claude models. Too tight and the
# review truncates mid-JSON, which looks like a parser bug.
LLM_MAX_TOKENS=16000

# No API key at all — Ollama, running locally. Needs no code changes:
#   LLM_PROVIDER=openai  OPENAI_BASE_URL=http://localhost:11434/v1
#   OPENAI_API_KEY=ollama  OPENAI_MODEL=qwen2.5-coder:14b
#   OPENAI_USE_JSON_SCHEMA=true
# 7B is too small: it cites files that are not in the diff, so every comment is
# dropped and the review comes back empty. See docs/SETUP.md.
# Free tier — Gemini via its OpenAI-compatible endpoint:
#   LLM_PROVIDER=openai  OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
#   OPENAI_API_KEY=<google ai studio key>  OPENAI_MODEL=gemini-2.5-flash
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4o
# Constrain generation to the review schema rather than just "valid JSON".
# Effectively required for local models; off by default because not every
# OpenAI-compatible endpoint implements it.
OPENAI_USE_JSON_SCHEMA=false

# ── Subscription providers: no API key, no metered billing ────────────────────
# LLM_PROVIDER=claude_code drives the Claude Code CLI, LLM_PROVIDER=codex the
# Codex CLI, each against a subscription you already pay for. Both are for
# LOCAL, PERSONAL use — see the README before pointing one at a shared
# deployment. Neither works in CI: the test suite must never need a signed-in
# CLI.
#
# Running Liffy directly on the host: install the CLI, sign in, done. The token
# lines below stay commented out.
#
# Running Liffy in Docker (what liffy.sh does): the container has no home
# directory holding your credentials, so there is one extra step per provider
# and you need the subscription overlay:
#   docker compose -f docker-compose.yml -f docker-compose.subscription.yml up --build
# Get it wrong and the worker refuses to start, with a message naming the fix —
# never a failure mid-review.
#
# claude_code in Docker: `claude setup-token` on the host prints this token.
# CLAUDE_CODE_OAUTH_TOKEN=
# CLAUDE_CODE_BINARY=claude
# CLAUDE_CODE_MODEL=claude-opus-5
# CLAUDE_CODE_TIMEOUT=600
#
# codex in Docker: there is NO token for this one. The Codex CLI has no auth
# environment variable and `codex login --with-access-token` will not take a
# ChatGPT subscription token. `./liffy.sh` adds docker-compose.codex.yml,
# mounts ~/.codex read-only, and sets CODEX_HOME=/codex-auth automatically.
# On a host-run worker, leave CODEX_HOME empty.
# CODEX_HOME=/codex-auth
# CODEX_BINARY=codex
# CODEX_TIMEOUT=600
# CODEX_EFFORT=medium
# Leave CODEX_MODEL unset unless you have a reason. Codex model slugs are
# specific to the CLI version and the account — an outdated pin fails the run
# with "Model metadata not found" — so by default Liffy uses whatever
# ~/.codex/config.toml already says.
# CODEX_MODEL=

# ── Embeddings ────────────────────────────────────────────────────────────────
# "local" runs BAAI/bge-small-en-v1.5 in-process: no key, no quota, no billing.
# First use downloads ~90MB. Switching provider changes the vector dimension
# (384 vs 1536), so it always requires dropping the Chroma collection and
# re-indexing — there is no migration path.
EMBEDDING_PROVIDER=local
LOCAL_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_MODEL=text-embedding-3-small
DEBUG=True

# Comma-separated origins allowed to call the API (the Vite dev server).
CORS_ORIGINS=http://localhost:5173

# ── Posting reviews back to GitHub (GH-2) ─────────────────────────────────────
# Off by default. Writing to somebody's pull request is not a behaviour a merge
# should silently switch on, and the test suite must never be one env var away
# from posting to a real PR.
POST_REVIEWS_TO_GITHUB=False
# "comment_only" (default) posts every review as a COMMENT.
# "native" sends approve/request_changes as real GitHub review events — which
# blocks a human's merge, so it is opt-in. On your own PR the choice is moot:
# GitHub 422s either event and Liffy downgrades to COMMENT, saying so in the
# posted body.
GITHUB_REVIEW_EVENT_MODE=comment_only
